table FunnelSummary
	lineageTag: 74552936-d835-4e6e-ae26-24f6b9fd6bfe

	column role_family
		dataType: string
		lineageTag: 3db2c6a2-ed62-4187-af53-928983f9f1f3
		summarizeBy: none
		sourceColumn: role_family

		annotation SummarizationSetBy = Automatic

	column total_applications
		dataType: int64
		lineageTag: 64eecebc-e596-4d51-b473-0d18126a8d5d
		summarizeBy: none
		formatString: #,0
		sourceColumn: total_applications

		annotation SummarizationSetBy = Automatic

	column reached_screen
		dataType: int64
		lineageTag: c0390238-757c-4a45-b977-2cfb17fbf61a
		summarizeBy: none
		formatString: #,0
		sourceColumn: reached_screen

		annotation SummarizationSetBy = Automatic

	column reached_interview
		dataType: int64
		lineageTag: 4e79abd9-b69a-475e-a89d-ceebd834ef57
		summarizeBy: none
		formatString: #,0
		sourceColumn: reached_interview

		annotation SummarizationSetBy = Automatic

	column reached_offer
		dataType: int64
		lineageTag: 3d968ded-8a80-45eb-95c9-7d58d6bd4ccf
		summarizeBy: none
		formatString: #,0
		sourceColumn: reached_offer

		annotation SummarizationSetBy = Automatic

	column reached_hire
		dataType: int64
		lineageTag: c1c91512-76db-4942-9834-f9969ad8ca44
		summarizeBy: none
		formatString: #,0
		sourceColumn: reached_hire

		annotation SummarizationSetBy = Automatic

	measure 'Total Applications' = SUM(FunnelSummary[total_applications])
		formatString: #,0
		lineageTag: 0730dbb5-eaf6-474b-b943-25b3f235350d

	measure 'Total Screened' = SUM(FunnelSummary[reached_screen])
		formatString: #,0
		lineageTag: a85d5e7f-cd24-4675-8391-9b8750e4f2ee

	measure 'Total Interviewed' = SUM(FunnelSummary[reached_interview])
		formatString: #,0
		lineageTag: ef6ea966-8dd8-438c-baed-a4b26a444bd6

	measure 'Total Offered' = SUM(FunnelSummary[reached_offer])
		formatString: #,0
		lineageTag: 58f336fe-d262-4797-9b33-56ad1fae739a

	measure 'Total Hired' = SUM(FunnelSummary[reached_hire])
		formatString: #,0
		lineageTag: 518e084d-454d-4cf0-974c-a5a663833840

	measure 'Screen Rate' = DIVIDE([Total Screened], [Total Applications])
		formatString: 0.00%
		lineageTag: bb96621e-c3db-4d7c-b9e9-35e4f4646f95

	measure 'Interview Rate' = DIVIDE([Total Interviewed], [Total Screened])
		formatString: 0.00%
		lineageTag: f466cded-645b-45d1-962c-4eda31db583a

	measure 'Offer Rate' = DIVIDE([Total Offered], [Total Interviewed])
		formatString: 0.00%
		lineageTag: d73b2142-4b1b-4acf-91ee-e4c346e1e89f

	measure 'Hire Rate' = DIVIDE([Total Hired], [Total Offered])
		formatString: 0.00%
		lineageTag: 632c8964-efbf-4d15-ba17-d0d503d28700

	measure 'Overall Selection Rate' = DIVIDE([Total Hired], [Total Applications])
		formatString: 0.00%
		lineageTag: 4d7ef29a-56b3-4243-b49c-ade6e97015ec

	partition FunnelSummary = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5433", "analytics"),
					hiring_bias_powerbi_funnel_summary = Source{[Schema="hiring_bias",Item="powerbi_funnel_summary"]}[Data]
				in
					hiring_bias_powerbi_funnel_summary

	annotation PBI_ResultType = Table
