table FunnelSummary
	lineageTag: 253af437-b737-4155-a98c-0cd7be2209f5

	column role_family
		dataType: string
		lineageTag: f1f46a6f-0f62-4f21-9a1d-765d7a3a3ead
		summarizeBy: none
		sourceColumn: role_family

		annotation SummarizationSetBy = Automatic

	column total_applications
		dataType: int64
		lineageTag: aa1c056a-2dcf-40a3-a589-157834e7ef02
		summarizeBy: none
		formatString: #,0
		sourceColumn: total_applications

		annotation SummarizationSetBy = Automatic

	column reached_screen
		dataType: int64
		lineageTag: 4566adce-92ba-45e6-9f85-9877e15353e2
		summarizeBy: none
		formatString: #,0
		sourceColumn: reached_screen

		annotation SummarizationSetBy = Automatic

	column reached_interview
		dataType: int64
		lineageTag: 2bbdc017-4db9-4157-80f6-26981662b1b6
		summarizeBy: none
		formatString: #,0
		sourceColumn: reached_interview

		annotation SummarizationSetBy = Automatic

	column reached_offer
		dataType: int64
		lineageTag: c804a02d-477e-43f0-baee-881b2bf7ca5f
		summarizeBy: none
		formatString: #,0
		sourceColumn: reached_offer

		annotation SummarizationSetBy = Automatic

	column reached_hire
		dataType: int64
		lineageTag: c882c083-cc21-43dd-bb76-ca5ab32b6bf1
		summarizeBy: none
		formatString: #,0
		sourceColumn: reached_hire

		annotation SummarizationSetBy = Automatic

	measure 'Total Applications' = SUM(FunnelSummary[total_applications])
		formatString: #,0
		lineageTag: dd7d97a3-7491-4584-8819-df7c5ce7633a

	measure 'Total Screened' = SUM(FunnelSummary[reached_screen])
		formatString: #,0
		lineageTag: 2dd028f5-1f1b-4345-9505-9863fc3d7f99

	measure 'Total Interviewed' = SUM(FunnelSummary[reached_interview])
		formatString: #,0
		lineageTag: ffcb032d-3732-4923-803a-4b85dbcad04b

	measure 'Total Offered' = SUM(FunnelSummary[reached_offer])
		formatString: #,0
		lineageTag: b29a6dfd-b056-4805-ab7a-8232036a1b01

	measure 'Total Hired' = SUM(FunnelSummary[reached_hire])
		formatString: #,0
		lineageTag: 6282655c-8c07-42cf-b414-eeda07d79225

	measure 'Screen Rate' = DIVIDE([Total Screened], [Total Applications])
		formatString: 0.00%
		lineageTag: ef04155f-5a97-402c-b3af-aa5dbfe67e85

	measure 'Interview Rate' = DIVIDE([Total Interviewed], [Total Screened])
		formatString: 0.00%
		lineageTag: c510a199-b7ec-402d-a7f2-ddcd1172eff8

	measure 'Offer Rate' = DIVIDE([Total Offered], [Total Interviewed])
		formatString: 0.00%
		lineageTag: 3bf04385-6470-48ac-9f00-3d2e70f72938

	measure 'Hire Rate' = DIVIDE([Total Hired], [Total Offered])
		formatString: 0.00%
		lineageTag: 8ce9dd9c-fa14-4d6a-baa0-a13f3dc96159

	measure 'Overall Selection Rate' = DIVIDE([Total Hired], [Total Applications])
		formatString: 0.00%
		lineageTag: c77361b1-218c-468e-9f6c-4d797688d8c3

	partition FunnelSummary = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5433", "analytics"),
					hiring_bias_powerbi_funnel_summary = Source{[Schema="hiring_bias",Item="powerbi_funnel_summary"]}[Data]
				in
					hiring_bias_powerbi_funnel_summary

	annotation PBI_ResultType = Table
